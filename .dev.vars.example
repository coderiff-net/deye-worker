# Copy this file to .dev.vars and replace every placeholder.
# Never commit .dev.vars or share its contents.
DEYE_APP_ID=replace
DEYE_STATION_ID=replace
ARISTON_GATEWAY=replace
ARISTON_EMAIL=replace
ARISTON_PASSWORD=replace
DEYE_APP_SECRET=replace
DEYE_EMAIL=replace
# SHA-256 hex digest used directly by Deye (as in the Bruno collection)
DEYE_PASSWORD=replace
# Keep local scheduled checks read-only while testing
DRY_RUN=true
